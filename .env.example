# App URL (used for WhatsApp share links, OG URLs, and Paystack callback_url)
# Local dev: http://localhost:3000 | Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: bypasses RLS for checkout order creation and Paystack verification
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack (GHS / Mobile Money)
# Use your Paystack Dashboard -> Settings -> API Keys & Webhooks -> Test keys for dev
# Server-only secret key (starts with sk_test_ in test mode, sk_live_ in production)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Public key (starts with pk_test_ in test mode, pk_live_ in production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Arkesel SMS (Ghana)
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=AkwaabaCrgo
